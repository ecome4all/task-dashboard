generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// tenantId is unused while there's only one business on the system, but every
// row carries it from day one so multi-tenant resale later is a query filter,
// not a schema migration.
model Task {
  id           String     @id @default(cuid())
  tenantId     String     @default("default")
  source       String // "whatsapp_group" | "whatsapp_official"
  sourceRef    String // WhatsApp group id or phone number the task came from
  // Human-readable group name from whapi's webhook (chat_name), captured at
  // intake time so staff can recognize a group without reading its raw JID.
  // Null for official-channel (1:1) tasks, which have no group name.
  chatName     String?
  description  String
  clientName   String?
  assignee     String?
  // listing | inventory_manage | fba | claims | inactive_blocked_product | no_pickup | ads | other
  // Nothing is auto-filled — same as assignee, this is picked manually during triage.
  taskType     String?
  // amazon | flipkart | meesho | other — also manually picked, not auto-detected from the message.
  marketplace  String?
  // no_action_yet | started | submitted | waiting_for_marketplace | waiting_for_client | again_submitted | done
  //
  // A task arrives having had nothing done to it, so that is what it says.
  // The default used to be "started", which claimed work had begun on every
  // message the moment it landed — and left no way to mark the tasks somebody
  // actually had started. "started" is still a status, now meaning what it
  // says; tasks created before this keep it.
  status       String     @default("no_action_yet")
  // Set by an admin or manager only (see requireRole check in tasks.ts) —
  // members can't set their own due dates.
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  doneAt       DateTime?
  // Snapshot of status/marketplace/taskType/assignee/dueDate/createdAt as of
  // the last successful WhatsApp send (manual "Send" click, or an automatic
  // status-change notification) — lets the Send button compare current
  // values against this to work out what's actually new, with no manual
  // field picking. Null means nothing's ever been sent for this task yet.
  sentSnapshot Json?
  notes        TaskNote[]

  @@index([tenantId, status])
}

// A running log of remarks on a task, oldest first. Deliberately a log and
// not a single editable field on Task: several people work the same task
// over days, and one shared box means whoever types next silently destroys
// the previous person's context.
model TaskNote {
  id           String    @id @default(cuid())
  tenantId     String    @default("default")
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Both the id and a snapshot of the name at write time: an employee can
  // be renamed or deactivated later, and an old note should still show who
  // actually wrote it, without a join that might come back empty.
  authorId     String
  authorName   String
  body         String
  createdAt    DateTime  @default(now())
  // Whether this note is meant for the client at all. Internal by default,
  // because plenty of them ("client hasn't paid yet") must never reach the
  // client — ticking the box on the note form is what sets this.
  //
  // Saying yes does not send anything on its own. The note waits and goes out
  // as part of the next update the task sends, rather than arriving as a
  // WhatsApp message of its own: a client watching a request move should get
  // one message about it, not a status change followed by a loose paragraph.
  sendToClient Boolean   @default(false)
  // When this note actually reached the client's group, if it has yet. Null
  // with sendToClient true means it is still waiting for the next update;
  // null with sendToClient false means it was never meant to go.
  sentAt       DateTime?

  @@index([taskId])
}

// A task set to repeat, created from an existing one via "Repeat this".
// Holds its own copy of the fields a new Task needs rather than pointing at
// the original — the original can be edited or deleted afterwards, and that
// must not change or break what the repeat produces.
//
// nextRunAt is the scheduler's queue: the job picks up every active row
// whose nextRunAt has passed, creates the Task, then moves nextRunAt
// forward by `frequency`. Storing the next time (instead of recomputing it
// from lastRunAt) means a backend that was asleep or redeploying catches up
// on exactly one run rather than replaying every missed one.
model RecurringTask {
  id          String    @id @default(cuid())
  tenantId    String    @default("default")
  // Copied onto each Task this creates — same shape task intake produces,
  // so a repeated task is indistinguishable from one sent over WhatsApp.
  source      String
  sourceRef   String
  chatName    String?
  description String
  clientName  String?
  assignee    String?
  taskType    String?
  marketplace String?
  // "daily" | "weekly" | "fortnightly" | "monthly"
  frequency   String
  nextRunAt   DateTime
  lastRunAt   DateTime?
  active      Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([tenantId, active, nextRunAt])
}

model Employee {
  id           String  @id @default(cuid())
  tenantId     String  @default("default")
  name         String
  email        String? @unique
  passwordHash String?
  role         String  @default("member") // "admin" | "manager" | "member"
  active       Boolean @default(true)
  // WhatsApp number for the daily "your open work" reminder. Optional: an
  // employee without one simply doesn't get reminders, rather than the
  // reminder job failing. Stored in the same normalized form as Client.phone
  // (country code, digits only) so it can be handed straight to an adapter.
  phone        String?
}

// A managed directory of clients, separate from Task.clientName (which is
// just whatever name comes in on the WhatsApp source and isn't linked here).
// Lets report-sends pick a saved phone number instead of retyping it.
model Client {
  id             String                @id @default(cuid())
  tenantId       String                @default("default")
  name           String
  phone          String?
  notes          String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  whatsappGroups ClientWhatsappGroup[]
  reportSheets   ClientReportSheet[]
}

// The Google Sheet a client's performance numbers are kept in — read-only
// from this app's side, via a service account the sheet is shared with (see
// services/googleSheets.ts). Whole-account tracker, not per-SKU: no ASIN
// column, every row is a time period (a week or a date).
//
// One sheet per marketplace, not one per client: a client selling on both
// Amazon and Flipkart has two separate sets of figures, and one sheet can't
// hold two accounts' numbers in the same columns. Was a single
// `Client.reportSheetUrl` until then — the migration moved every existing
// sheet onto "amazon", which is what all of them were.
//
// A client with no row here simply gets no report, the same as an empty
// reportSheetUrl did.
model ClientReportSheet {
  id          String   @id @default(cuid())
  tenantId    String   @default("default")
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  // A ConfigOption "marketplace" value — "amazon", "flipkart" — the same
  // values a task carries, so a report and a task agree on what to call it.
  marketplace String
  sheetUrl    String
  createdAt   DateTime @default(now())

  // One sheet per marketplace per client: linking a second Amazon sheet is a
  // mistake, not a second account, and silently sending from whichever came
  // back first would be worse than refusing it.
  @@unique([tenantId, clientId, marketplace])
  @@index([clientId])
}

// One of possibly several WhatsApp groups a client's tasks come from (whapi
// chat_id, e.g. "919001524054-1380436383@g.us"), and its display name at the
// time it was linked. Manually assigned by staff from the groups seen on
// incoming tasks — never auto-matched. A client with any groups linked sends
// client updates to one of them (picked at send time) instead of `phone`;
// @@unique on groupId keeps one group from being linked to two clients at once.
model ClientWhatsappGroup {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  groupId   String
  groupName String?
  createdAt DateTime @default(now())

  @@unique([tenantId, groupId])
  @@index([clientId])
}

// A task: message from a chat_id that isn't tied to any active Client yet —
// logged here instead of becoming a Task, so an unknown number can't spam
// the board, while staff can still see it, recognize it, and link it to a
// client (or add a new one) from the Clients tab. Once linked, that chat_id's
// future messages become real Tasks; existing rows here for it are just
// filtered out of the "unrecognized" view, not deleted.
model UnrecognizedMessage {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  source    String
  sourceRef String // chat_id
  chatName  String?
  text      String
  createdAt DateTime @default(now())

  @@index([tenantId, sourceRef])
}

// Admin-editable dropdown options for Task fields: "marketplace", "status",
// and "task_type". `value` is the stable machine value stored on Task rows
// (e.g. "amazon") and is never changed after creation, even if `label` is
// renamed later — existing tasks keep referencing it correctly either way.
// Deactivating an option removes it from the dropdown going forward without
// touching tasks that already used it. Employee role and the Employee/
// Assignee dropdown itself aren't here: role is tied to real permission code
// (an arbitrary new role would have no actual access behavior), and Assignee
// is already dynamic — it's just the live Employees list.
model ConfigOption {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  category  String // "marketplace" | "status" | "task_type"
  value     String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, category, value])
}
