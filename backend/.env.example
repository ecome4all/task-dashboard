# Postgres connection string (Neon or Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Port the server listens on
PORT=4000

# Where the frontend runs — needed so cookies/CORS work for login
# (pinned to 5190 in frontend/vite.config.ts to avoid colliding with other
# locally-running projects' dev servers). Comma-separate multiple values if
# the frontend is reachable at more than one URL (e.g. a custom domain
# alongside the original auto-generated Vercel one).
FRONTEND_URL="http://localhost:5190"

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Shared secret appended to the whapi.cloud webhook URL as ?secret=...
# (whapi.cloud has no built-in request signing, so this is what stops
# arbitrary internet requests from creating fake tasks)
WEBHOOK_SHARED_SECRET=""

# Used by the seed script to create the first login (see prisma/seed.ts)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"

# Periskope (group channel). API key from Periskope Settings > API Keys;
# phone is the dedicated WhatsApp number connected to it, digits only, no "+".
# Currently 918733071033 — the Ecom4all number linked to Periskope. Changing
# this means the new number must also be a member of every WhatsApp group you
# want sends to keep working in (see README).
PERISKOPE_API_KEY=""
PERISKOPE_PHONE="918733071033"
# Signing key from Periskope Settings > Webhooks — verifies the
# x-periskope-signature header on incoming webhook calls (HMAC-SHA256 of the
# raw request body). Register the webhook URL as:
#   https://<this-backend>/webhook/periskope
PERISKOPE_WEBHOOK_SECRET=""

# Scheduler (creates repeating tasks when due, sends the daily employee
# reminder). Runs inside the backend process — no external cron needed.
# REMINDER_HOUR is the local hour (0-23) the daily "your open work" message
# goes out; defaults to 9. Set DISABLE_SCHEDULER=true to turn the whole thing
# off — needed only if a second backend instance is ever run alongside this
# one, which would otherwise both create the same repeating tasks.
REMINDER_HOUR="9"
DISABLE_SCHEDULER=""

# whapi.cloud (unused — the group channel runs on Periskope instead, see
# above. Left here in case whapi.cloud is ever reconnected; /webhook/whapi
# still exists and works if these are filled in.)
WHAPI_API_KEY=""
WHAPI_BASE_URL="https://gate.whapi.cloud"

# Official WhatsApp Cloud API (added in Phase 3 - leave blank until then)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
# Arbitrary string you choose; enter the same value when registering the
# webhook URL in the Meta App Dashboard so it can verify the endpoint
WHATSAPP_VERIFY_TOKEN=""

# Google service account for read-only access to clients' report sheets (see
# services/googleSheets.ts / Weekly Reports screen). Create a service
# account in Google Cloud Console, enable the Sheets API, generate a JSON
# key, then pull just these two fields out of it rather than storing the
# whole file. Each client's sheet needs to be shared with
# GOOGLE_SERVICE_ACCOUNT_EMAIL (Viewer) before its data can be read.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The JSON key's "private_key" field, pasted as-is (its embedded newlines
# are literal "\n" escape sequences in the JSON, which is exactly what an
# env var needs — see googleSheets.ts, which un-escapes them before use).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Scheduled client reports -------------------------------------------
# When on, the scheduler sends the chosen report to EVERY active client with
# a report sheet linked, on this day and hour, 5 seconds apart. Nobody
# presses anything, and the messages go to clients — so this stays off
# unless REPORT_SEND_ENABLED is exactly "true". Anything else, including a
# missing value, means off.
REPORT_SEND_ENABLED="false"
# daily | weekly_sales | weekly_sku | monthly
REPORT_SEND_KIND="weekly_sales"
# 0 = Sunday ... 6 = Saturday, or "every" for a report that goes out daily.
# An unrecognised value falls back to Monday, not to every day.
REPORT_SEND_DAY="1"
# Whole hour, 0-23, in the server's local time. The scheduler ticks every 5
# minutes and fires on the first tick inside this hour.
REPORT_SEND_HOUR="10"
